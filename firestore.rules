rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // An admin is a signed-in user with an active admin document.
      // NOTE: Using exists() is more performant and required for client-side transactions.
      if (!isSignedIn()) {
        return false;
      }
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Admin-Managed Collections ---
    match /clients/{docId} { allow read, write: if isAdmin(); }
    match /drivers_v2/{docId} { allow read, write: if isAdmin(); }
    match /storeOwners/{docId} { allow read, write: if isAdmin(); }
    
    // Admin collection: Allow signed-in users to check for existence, but only admins to list/write.
    match /admins/{docId} {
        allow get: if isSignedIn();
        allow list, create, update, delete: if isAdmin();
    }

    match /bankAccounts/{docId} { 
      allow get, list: if isSignedIn();
      allow write: if isAdmin();
    }
    match /store_filters/{docId} { allow read, write: if isAdmin(); }
    match /products/{docId} { allow read, write: if isAdmin(); }
    match /donations/{docId} { allow read, write: if isAdmin(); }
    match /coupons/{docId} { allow read, write: if isAdmin(); }
    match /vipPackages/{docId} { allow read, write: if isAdmin(); }
    match /vipSubscriptions/{docId} { allow read, write: if isAdmin(); }
    match /loyaltyRules/{docId} { allow read, write: if isAdmin(); }
    match /point_requests/{requestId} { allow read, write: if isAdmin(); }
    match /loyaltyLogs/{logId} { allow read, write: if isAdmin(); }
    
    match /orders/{orderId} { allow read, write: if isAdmin(); }
    match /supportTickets/{ticketId} { allow read, write: if isAdmin(); }
    match /notificationTemplates/{docId} { allow read, write: if isAdmin(); }
    match /broadcasts/{docId} { allow read, write: if isAdmin(); }
    match /notifications/{docId} { allow read, write: if isAdmin(); }
    
    // --- Public Read to unblock seeding flow, Admin Write ---
    match /systemSettings/{docId} { 
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    // --- Public Read / Admin Write Collections ---
    match /app_provinces/{docId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /app_categories/{docId} { 
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /adBanners/{docId} { 
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /stores/{docId} { 
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /donationTypes/{docId} { 
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /donationCampaigns/{docId} { 
      allow get, list: if true;
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // --- Public Read-Only Collections ---
    match /governorates/{docId} {
      allow get, list: if true;
      allow write: if false; // Explicitly disallow writes
    }
    match /storeCategories/{docId} {
      allow get, list: if true;
      allow write: if false; // Explicitly disallow writes
    }
    
    // --- User-Specific Data ---
    match /users/{userId} {
      // User Profile: Only owner can access
      match /profile/{profileId} {
        allow read, write: if isOwner(userId);
      }
      // User Wallet: Admins can write and read. Owner can only read.
      match /wallet/{walletId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list, write: if isAdmin();
      }
      // Wallet Transactions: Readable by owner or admin, writable by admin.
      match /walletTransactions/{transactionId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isAdmin();
        // Transactions should be immutable
        allow update, delete: if false;
      }
    }

    match /addresses/{addressId} {
      allow list, create: if isSignedIn();
      allow get, update, delete: if isOwner(resource.data.userId);
    }
  }
}

    