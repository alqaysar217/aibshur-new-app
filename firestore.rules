/**
 * Core Philosophy:
 * This ruleset enforces a security model with two primary postures. First, it defines several top-level
 * collections as publicly readable to support the app's need to display global data. Writes to this public data are
 * restricted to admins. Second, it establishes a strict user-ownership model for private data.
 *
 * Data Structure:
 * - Public Data: `governorates`, `storeCategories`, `adBanners`, `stores`, `products`, etc., are in top-level collections
 *   for easy public access.
 * - Private User Data: User profiles are segregated into a user-specific path (`/users/{userId}/profile`).
 * - Role-Based User Data: `clients`, `drivers`, `storeOwners`, and `admins` are in top-level collections,
 *   managed exclusively by administrators.
 *
 * Key Security Decisions:
 * - Public Data: Publicly readable (`get`, `list`), with writes restricted to authenticated users (admins).
 * - Private User Data (`profile`): Strictly private. A user can only access documents under their own `/users/{userId}` path.
 * - Admin-Managed User Data: All top-level user collections (`clients`, `drivers`, etc.) are only listable and
 *   modifiable by authenticated admins to prevent data leakage and unauthorized access.
 * - No User Listing: The top-level `/users` collection is not listable, preventing enumeration of all app users.
 * - Default Secure: For any operation not explicitly granted, access is denied.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    //-------------------------------------------------------------------------
    // User Role Collections
    //-------------------------------------------------------------------------

    match /clients/{clientId} {
      allow get, create, update, delete: if isSignedIn();
    }
    match /clients {
      allow list: if isSignedIn();
    }

    match /drivers/{driverId} {
      allow get, create, update, delete: if isSignedIn();
    }
    match /drivers {
      allow list: if isSignedIn();
    }
    
    match /storeOwners/{ownerId} {
      allow get, create, update, delete: if isSignedIn();
    }
    match /storeOwners {
      allow list: if isSignedIn();
    }

    match /admins/{adminId} {
      allow get, create, update, delete: if isSignedIn();
    }
    match /admins {
      allow list: if isSignedIn();
    }

    //-------------------------------------------------------------------------
    // Admin-Managed Core Data
    //-------------------------------------------------------------------------

    match /bankAccounts/{bankAccountId} {
      allow read, write: if isSignedIn();
    }
    
    match /app_provinces/{appProvinceId} {
      allow read, write: if isSignedIn();
    }

    match /app_categories/{appCategoryId} {
      allow read, write: if isSignedIn();
    }

    match /store_filters/{storeFilterId} {
      allow read, write: if isSignedIn();
    }
    
    match /donations/{donationId} {
      allow read, write: if isSignedIn();
    }
    
    match /coupons/{couponId} {
      allow read, write: if isSignedIn();
    }

    //-------------------------------------------------------------------------
    // Publicly Readable Data
    //-------------------------------------------------------------------------

    match /governorates/{governorateId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if false; // Prevent access to parent user docs
      
      match /profile/{profileId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    match /storeCategories/{storeCategoryId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /adBanners/{adBannerId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /stores/{storeId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }
    
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /donationTypes/{donationTypeId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }

    match /donationCampaigns/{campaignId} {
      allow get, list: if true;
      allow write: if isSignedIn();
    }
  }
}
