rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // For prototyping, any signed-in user is considered an admin for the dashboard.
      return isSignedIn();
    }

    // --- NEW NOTIFICATIONS RULE ---
    match /notifications/{docId} {
        allow read, write: if isAdmin();
    }

    // --- Admin-Managed Collections ---
    match /clients/{docId} { allow read, write: if isAdmin(); }
    match /drivers_v2/{docId} { allow read, write: if isAdmin(); }
    match /storeOwners/{docId} { allow read, write: if isAdmin(); }
    match /admins/{docId} { allow read, write: if isAdmin(); }
    match /bankAccounts/{docId} { allow read, write: if isAdmin(); }
    match /app_categories/{docId} { allow read, write: if isAdmin(); }
    match /store_filters/{docId} { allow read, write: if isAdmin(); }
    match /products/{docId} { allow read, write: if isAdmin(); }
    match /donations/{docId} { allow read, write: if isAdmin(); }
    match /coupons/{docId} { allow read, write: if isAdmin(); }
    match /vipPackages/{docId} { allow read, write: if isAdmin(); }
    match /vipSubscriptions/{docId} { allow read, write: if isAdmin(); }
    match /loyaltyRules/{docId} { allow read, write: if isAdmin(); }
    match /point_requests/{docId} { allow read, write: if isAdmin(); }
    match /loyaltyLogs/{docId} { allow read, write: if isAdmin(); }
    match /orders/{orderId} { allow read, write: if isAdmin(); }
    match /supportTickets/{ticketId} { allow read, write: if isAdmin(); }
    match /notificationTemplates/{docId} { allow read, write: if isAdmin(); }
    match /broadcasts/{docId} { allow read, write: if isAdmin(); }
    
    // --- Public Read to unblock seeding flow, Admin Write ---
    match /systemSettings/{docId} { 
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // --- Public Read / Admin Write Collections ---
    match /app_provinces/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adBanners/{docId} { 
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stores/{docId} { 
      allow read: if true;
      allow write: if isAdmin();
    }
    match /donationTypes/{docId} { 
      allow read: if true;
      allow write: if isAdmin();
    }
    match /donationCampaigns/{docId} { 
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Public Read-Only Collections ---
    match /governorates/{docId} {
      allow read: if true;
      allow write: if false; // Explicitly disallow writes
    }
    match /storeCategories/{docId} {
      allow read: if true;
      allow write: if false; // Explicitly disallow writes
    }
    
    // --- User-Specific Data ---
    match /users/{userId} {
      // User Profile: Only owner can access
      match /profile/{profileId} {
        allow read, write: if isOwner(userId);
      }
      // User Wallet: Owner and Admin can access
      match /wallet/{walletId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }
    }
  }
}
