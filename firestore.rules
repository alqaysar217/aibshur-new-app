rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // For prototyping, any signed-in user is considered an admin for the dashboard.
      return isSignedIn();
    }

    // Admin-Managed Collections (Full CRUD for Admins)
    match /{collectionId}/{docId}
      where collectionId in [
        'clients', 'drivers_v2', 'storeOwners', 'admins', 
        'bankAccounts', 'app_provinces', 'app_categories', 'store_filters',
        'products', 'donations', 'coupons', 'vipPackages', 'vipSubscriptions',
        'loyaltyRules', 'point_requests', 'loyaltyLogs'
      ] {
      allow read, write: if isAdmin();
    }
    
    // Public Read / Admin Write Collections
    match /{collectionId}/{docId} 
      where collectionId in [
        'adBanners', 'stores', 'donationTypes', 'donationCampaigns'
      ] {
        allow get, list: if true;
        allow write: if isAdmin();
    }

    // Public Read-Only Collections
    match /{collectionId}/{docId}
      where collectionId in ['governorates', 'storeCategories'] {
      allow read: if true;
      allow write: if false;
    }
    
    // User-Specific Data
    match /users/{userId} {
      // User Profile
      match /profile/{profileId} {
        allow read, write: if isOwner(userId);
      }
      // User Wallet
      match /wallet/{walletId} {
        allow read, write: if isAdmin() || isOwner(userId);
      }
    }
  }
}
